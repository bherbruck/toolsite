# Copy to .env and fill in. At least one auth mode is required.
#
# MCP is in the names below because they authenticate MCP clients — who may
# publish — and nothing else. Visitor accounts are a separate system with no
# environment variables at all.

TOOLSITE_MCP_TOKEN=

# With the base URL set, clients (claude.ai, Claude Code) need no token at
# all: they send the person to sign in with an admin account and consent.
# TOOLSITE_BASE_URL=https://yourdomain.com

TOOLSITE_DATA_DIR=./data

# Subdomain mode: each app on a host of its own, <label>.<domain>, so one
# app's scripts cannot act as a visitor towards another app. Needs the base
# URL and a wildcard DNS record (*.apps.yourdomain.com). The port, if any,
# comes from the base URL; TOOLSITE_APPS_PORT overrides it. Locally:
# TOOLSITE_BASE_URL=http://localhost:8080 with TOOLSITE_APPS_DOMAIN=apps.localhost
# TOOLSITE_APPS_DOMAIN=apps.yourdomain.com

# Sign-in buttons besides the password form. One group per slug; register
# https://yourdomain.com/auth/callback/<slug> at the provider. GOOGLE, GITHUB,
# MICROSOFT and ENTRA (with _TENANT) know their issuer; anything else gives
# _ISSUER. _NAME labels the button, _ALLOW_DOMAIN makes accounts for a domain.
# TOOLSITE_LOGIN_GOOGLE_CLIENT_ID=
# TOOLSITE_LOGIN_GOOGLE_CLIENT_SECRET=
# TOOLSITE_LOGIN_ENTRA_TENANT=
# TOOLSITE_LOGIN_ENTRA_CLIENT_ID=
# TOOLSITE_LOGIN_ENTRA_CLIENT_SECRET=
# TOOLSITE_LOGIN_ENTRA_ALLOW_DOMAIN=

# Two-step sign-in (a code from an authenticator app after the password).
# Who must have it: admins (the default), everyone, or off. Someone covered
# without it sets it up at the next sign-in, before any session.
# TOOLSITE_REQUIRE_MFA=admins
# 1: a sign-in through a provider also asks for the code. Off, the
# provider's own second step counts.
# TOOLSITE_MFA_FOR_PROVIDERS=0

# What an app is until it says otherwise: public, authenticated or granted.
# An internal site sets granted here and opens the few apps that should be.
# TOOLSITE_DEFAULT_ACCESS=public

# What an app's [limits] may ask for, at most. Without asking, a request
# gets 5 s, 200M fuel, 64 MB and 1000 rows a query; a job 60 s, 2G fuel and
# 128 MB. A fuel ceiling of none meters no fuel at all.
# TOOLSITE_MAX_REQUEST_SECONDS=60
# TOOLSITE_MAX_REQUEST_FUEL=2000000000
# TOOLSITE_MAX_JOB_SECONDS=900
# TOOLSITE_MAX_JOB_FUEL=100000000000
# TOOLSITE_MAX_QUERY_ROWS=50000
# TOOLSITE_MAX_MEMORY_MB=1024
# Jobs one app may start from its handler (jobs.run) a minute.
# TOOLSITE_JOB_STARTS_PER_MINUTE=600
# Jobs of one app that may run at once, however they were started.
# TOOLSITE_JOBS_RUNNING_PER_APP=4

# Ceilings in MB; 0 lifts one. Defaults are a few GB each.
# TOOLSITE_MAX_DB_MB=4096
# TOOLSITE_MAX_BLOB_MB=4096

# Apps' files go beside them on the volume unless a bucket is named. A
# Railway bucket's ENDPOINT, BUCKET, ACCESS_KEY_ID, SECRET_ACCESS_KEY and
# REGION are accepted under those names too.
# TOOLSITE_BLOB_S3_ENDPOINT=https://t3.storageapi.dev
# TOOLSITE_BLOB_S3_BUCKET=
# TOOLSITE_BLOB_S3_ACCESS_KEY_ID=
# TOOLSITE_BLOB_S3_SECRET_ACCESS_KEY=
# TOOLSITE_BLOB_S3_REGION=auto

# Platform state (accounts, sign-in clients, projects, records) in Postgres
# rather than under TOOLSITE_DATA_DIR, so more than one runner can share a
# site. Unset, everything stays in files. With it set, the server refuses
# to start without TOOLSITE_SECRET_KEY and a bucket (above), and on a data
# directory holding file-mode state that was not migrated. Never logged:
# boot logs show the host, port and database only. sslmode follows libpq:
# prefer (the default) and require encrypt without checking the
# certificate; verify-full checks it against the bundled roots, or against
# sslrootcert=<file>.
# DATABASE_URL=postgres://toolsite:password@db.internal:5432/toolsite?sslmode=verify-full
# Connections one runner holds.
# TOOLSITE_DATABASE_POOL=16
# Where other runners reach this one (Railway: its private address).
# TOOLSITE_RUNNER_ADDRESS=

# The key sealed values (app settings, two-step secrets) are encrypted with:
# 32 random bytes, base64 (`openssl rand -base64 32`). Unset in file mode, one
# is generated at .site/secret.key; required with DATABASE_URL, where admin
# form tokens are derived from it too. Losing it loses every sealed value.
# TOOLSITE_SECRET_KEY=

# A GitHub App lets an app's source live in a repository, with history.
# Register one as the README says; the key is the PEM, raw or base64.
# TOOLSITE_GITHUB_APP_ID=
# TOOLSITE_GITHUB_APP_PRIVATE_KEY=
# TOOLSITE_GITHUB_APP_SLUG=
# TOOLSITE_GITHUB_WEBHOOK_SECRET=

# PORT and RUST_LOG keep their usual names: the platform injects one and the
# Rust ecosystem owns the other.
PORT=8080
