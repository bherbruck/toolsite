# Copy to .env and fill in. At least one auth mode is required.
#
# MCP is in the names below because they authenticate MCP clients — who may
# publish — and nothing else. Visitor accounts are a separate system with no
# environment variables at all.

TOOLSITE_MCP_TOKEN=

# With the base URL set, clients (claude.ai, Claude Code) need no token at
# all: they send the person to sign in with an admin account and consent.
# TOOLSITE_BASE_URL=https://yourdomain.com

TOOLSITE_DATA_DIR=./data

# Ceilings in MB; 0 lifts one. Defaults are a few GB each.
# TOOLSITE_MAX_DB_MB=4096
# TOOLSITE_MAX_BLOB_MB=4096

# Apps' files go beside them on the volume unless a bucket is named. A
# Railway bucket's ENDPOINT, BUCKET, ACCESS_KEY_ID, SECRET_ACCESS_KEY and
# REGION are accepted under those names too.
# TOOLSITE_BLOB_S3_ENDPOINT=https://t3.storageapi.dev
# TOOLSITE_BLOB_S3_BUCKET=
# TOOLSITE_BLOB_S3_ACCESS_KEY_ID=
# TOOLSITE_BLOB_S3_SECRET_ACCESS_KEY=
# TOOLSITE_BLOB_S3_REGION=auto

# PORT and RUST_LOG keep their usual names: the platform injects one and the
# Rust ecosystem owns the other.
PORT=8080
