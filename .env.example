# Copy to .env and fill in. At least one auth mode is required.
#
# The old unprefixed names (BEARER_TOKEN, OAUTH_CLIENT_ID, OAUTH_CLIENT_SECRET,
# PUBLIC_BASE_URL, DATA_DIR, DATABASES) still work, so an existing deployment
# needs no changes.

TOOLSITE_TOKEN=

# Set both together, or neither. Needed only by clients that cannot send a
# bearer token, such as claude.ai connectors.
# TOOLSITE_OAUTH_CLIENT_ID=
# TOOLSITE_OAUTH_CLIENT_SECRET=
# TOOLSITE_BASE_URL=https://yourdomain.com

TOOLSITE_DATA_DIR=./data
TOOLSITE_DATABASES=on

# PORT and RUST_LOG keep their usual names: the platform injects one and the
# Rust ecosystem owns the other.
PORT=8080
