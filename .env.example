# Copy to .env and fill in. At least one auth mode is required.
#
# MCP is in the names below because they authenticate MCP clients — who may
# publish — and nothing else. Visitor accounts are a separate system with no
# environment variables at all.

TOOLSITE_MCP_TOKEN=

# Set both together, or neither. Needed only by clients that cannot send a
# bearer token, such as claude.ai connectors, which then also need the base
# URL below for discovery.
# TOOLSITE_MCP_OAUTH_CLIENT_ID=
# TOOLSITE_MCP_OAUTH_CLIENT_SECRET=
# TOOLSITE_BASE_URL=https://yourdomain.com

TOOLSITE_DATA_DIR=./data

# PORT and RUST_LOG keep their usual names: the platform injects one and the
# Rust ecosystem owns the other.
PORT=8080
